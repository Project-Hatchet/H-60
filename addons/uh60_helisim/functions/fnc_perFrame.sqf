#include "defines.hpp"

params ["_vehicle", "_frameTime"];

if (!local _vehicle) exitWith {};

if !(
	alive _vehicle &&
	{player == driver _vehicle || {_vehicle turretUnit [0] == player}} &&
	{_vehicle isKindOf "vtx_h60_base"}
) exitwith { systemChat format ["Exiting!"];};

/////////////////////////////////////////////////////////////////////////////////////////////
// Core                 /////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////
[_vehicle] call bmkhs_fnc_deltaTime;
[_vehicle] call bmkhs_fnc_onGround;
[_vehicle] call bmkhs_fnc_getVelocities;
[_vehicle] call bmkhs_fnc_getAccelerations;
[_vehicle] call bmkhs_fnc_calculateAeroValues;
/////////////////////////////////////////////////////////////////////////////////////////////
// Electrical           /////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////
[_vehicle] call bmkhs_electrical_fnc_update;

true