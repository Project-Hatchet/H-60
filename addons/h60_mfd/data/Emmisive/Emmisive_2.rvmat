class StageTI {
	texture = "";
};
ambient[] = {0.4, 0.4, 0.4, 1};
diffuse[] = {0, 0, 0, 0.5};
forcedDiffuse[] = {0, 0, 0, 0.5};
emmisive[] = {6, 6, 6, 1};
specular[] = {0, 0, 0, 0};
